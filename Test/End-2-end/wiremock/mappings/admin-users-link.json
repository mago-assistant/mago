{
  "mappings": [
    {
      "name": "Admin users link - turn 2, admin_navigator returned the Admin Users page",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/v1/chat/completions",
        "bodyPatterns": [
          {"contains": "E2E admin users link check"},
          {"contains": "\"role\":\"tool\""},
          {"contains": "Admin Users"}
        ]
      },
      "response": {
        "status": 200,
        "headers": {"Content-Type": "text/event-stream"},
        "bodyFileName": "admin-users-link-summary.sse",
        "chunkedDribbleDelay": {"numberOfChunks": 10, "totalDuration": 100}
      }
    },
    {
      "name": "Admin users link - turn 2 fallback, a tool result without the Admin Users page",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPath": "/v1/chat/completions",
        "bodyPatterns": [
          {"contains": "E2E admin users link check"},
          {"contains": "\"role\":\"tool\""}
        ]
      },
      "response": {
        "status": 200,
        "headers": {"Content-Type": "text/event-stream"},
        "bodyFileName": "admin-users-link-not-offered.sse",
        "chunkedDribbleDelay": {"numberOfChunks": 10, "totalDuration": 100}
      }
    },
    {
      "name": "Admin users link - turn 1, look the page up through admin_navigator",
      "priority": 3,
      "request": {
        "method": "POST",
        "urlPath": "/v1/chat/completions",
        "bodyPatterns": [
          {"contains": "E2E admin users link check"},
          {"doesNotMatch": "(?s).*\"role\":\"tool\".*"}
        ]
      },
      "response": {
        "status": 200,
        "headers": {"Content-Type": "text/event-stream"},
        "bodyFileName": "admin-users-link-tool-call.sse",
        "chunkedDribbleDelay": {"numberOfChunks": 20, "totalDuration": 200}
      }
    }
  ]
}
