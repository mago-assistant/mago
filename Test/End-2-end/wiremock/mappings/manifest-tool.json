{
  "mappings": [
    {
      "name": "Manifest tool - turn 2, summary after the tool ran",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/v1/chat/completions",
        "bodyPatterns": [
          {
            "contains": "E2E manifest check"
          },
          {
            "contains": "\"role\":\"tool\""
          },
          {
            "contains": "skip filler acknowledgements"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "text/event-stream"
        },
        "bodyFileName": "manifest-tool-summary.sse",
        "chunkedDribbleDelay": {
          "numberOfChunks": 20,
          "totalDuration": 200
        }
      }
    },
    {
      "name": "Manifest tool - turn 1, ask to create the block",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPath": "/v1/chat/completions",
        "bodyPatterns": [
          {
            "contains": "E2E manifest check"
          },
          {
            "doesNotMatch": ".*\"role\":\"tool\".*"
          },
          {
            "contains": "skip filler acknowledgements"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "text/event-stream"
        },
        "bodyFileName": "manifest-tool-call.sse",
        "chunkedDribbleDelay": {
          "numberOfChunks": 25,
          "totalDuration": 250
        }
      }
    }
  ]
}
