{
  "mappings": [
    {
      "name": "Slash history - the turn after two /cache clean writes, one allowed and one rejected",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/v1/chat/completions",
        "bodyPatterns": [
          {
            "contains": "E2E slash history check"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "text/event-stream"
        },
        "bodyFileName": "slash-history-checked.sse"
      }
    },
    {
      "name": "Slash history - follow-up turn after the allowed /cache clean translate",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPath": "/v1/chat/completions",
        "bodyPatterns": [
          {
            "contains": "cache clean translate"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "text/event-stream"
        },
        "bodyFileName": "slash-history-cleaned.sse"
      }
    }
  ]
}
