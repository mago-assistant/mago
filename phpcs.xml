<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="PHP_CodeSniffer" xsi:noNamespaceSchemaLocation="phpcs.xsd">
    <description>Mago Assistant configuration for CodeSniffer.</description>

    <rule ref="Magento2">
        <exclude name="Magento2.Annotation.MethodAnnotationStructure.NoCommentBlock"/>
        <exclude name="Magento2.PHP.FinalImplementation.FoundFinal"/>
    </rule>

    <exclude-pattern>registration.php</exclude-pattern>

    <!-- SSE endpoints require echo/exit by design -->
    <rule ref="Magento2.Security.LanguageConstruct.DirectOutput">
        <exclude-pattern>Controller/Adminhtml/Chat/Stream.php</exclude-pattern>
        <exclude-pattern>Controller/Adminhtml/Chat/Confirm.php</exclude-pattern>
        <exclude-pattern>Controller/Adminhtml/Chat/ReleasesSessionLock.php</exclude-pattern>
    </rule>
    <rule ref="Magento2.Security.LanguageConstruct.ExitUsage">
        <exclude-pattern>Controller/Adminhtml/Chat/Stream.php</exclude-pattern>
        <exclude-pattern>Controller/Adminhtml/Chat/Confirm.php</exclude-pattern>
    </rule>

    <!-- Playwright installs and reports are not ours to lint -->
    <exclude-pattern>Test/End-2-end/node_modules/*</exclude-pattern>
    <exclude-pattern>Test/End-2-end/playwright-report/*</exclude-pattern>

    <!-- Inline SVG icons: <path/>, <line/> and <polyline/> are void in SVG, which the sniff
         only knows as non-void HTML elements -->
    <rule ref="Magento2.Html.HtmlSelfClosingTags">
        <exclude-pattern>*.js</exclude-pattern>
    </rule>

    <!-- Toggling the fulltext index around the bulk corpus load has no DDL abstraction; the
         table name comes from getTableName(), never from input -->
    <rule ref="Magento2.SQL.RawQuery">
        <exclude-pattern>Model/Doc/Repository.php</exclude-pattern>
    </rule>

    <rule ref="Generic.PHP.RequireStrictTypes">
        <severity>9</severity>
        <exclude-pattern>*.phtml</exclude-pattern>
    </rule>

    <rule ref="./Test/Phpcs/MagoAssistant/Sniffs/Legal/CopyrightNoticeSniff.php">
        <severity>9</severity>
        <exclude-pattern>*.phtml</exclude-pattern>
    </rule>
</ruleset>
