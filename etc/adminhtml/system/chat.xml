<?xml version="1.0"?>
<include xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_include.xsd">
    <group id="chat" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
        <label>Chat Settings</label>
        <attribute type="expanded">1</attribute>
        <field id="language" translate="label comment" type="select" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
            <label>Response Language</label>
            <source_model>MagoAssistant\Mago\Model\Config\Source\Language</source_model>
            <comment>Language for assistant responses. "Auto-detect" matches the user's language.</comment>
        </field>
        <field id="system_prompt" translate="label comment" type="textarea" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
            <label>System Prompt</label>
            <comment>The system instruction sent with every conversation. Customize the assistant's behavior.</comment>
        </field>
        <field id="answer_widgets" translate="label comment" type="select" sortOrder="15" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
            <label>Answer Widgets</label>
            <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
            <comment>Let the assistant answer with stat cards, charts, tables and record lists instead of plain text where the data allows it. Adds a short instruction block to every request.</comment>
        </field>
        <field id="max_tool_iterations" translate="label comment" type="text" sortOrder="22" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
            <label>Max Tool Iterations</label>
            <comment>Maximum number of tool call loops per message (default: 10)</comment>
            <validate>validate-digits</validate>
        </field>
        <field id="assistant_name" translate="label comment" type="text" sortOrder="25" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
            <label>Assistant Name</label>
            <comment>Display name for the AI assistant (default: Mago).</comment>
        </field>
        <field id="accent_color" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
            <label>Accent Color</label>
            <comment>Background color for the chat header, user messages and buttons (default: #F26322).</comment>
            <validate>validate-no-empty</validate>
            <frontend_model>MagoAssistant\Mago\Block\Adminhtml\System\Config\ColorPicker</frontend_model>
        </field>
        <field id="text_color" translate="label comment" type="text" sortOrder="35" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
            <label>Text Color on Accent</label>
            <comment>Text and icon color on accent backgrounds — header, user messages, buttons (default: #FFFFFF).</comment>
            <validate>validate-no-empty</validate>
            <frontend_model>MagoAssistant\Mago\Block\Adminhtml\System\Config\ColorPicker</frontend_model>
        </field>
    </group>
</include>
