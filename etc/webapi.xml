<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">

    <route url="/V1/mago/indexers/reindex-all" method="POST">
        <service class="MagoAssistant\Mago\Api\WebApi\IndexerManagementInterface" method="reindexAll"/>
        <!-- Rebuilding every indexer is far more than core's "invalidate" grant (flag an indexer
             for a rebuild), so it needs its own resource as well. -->
        <resources>
            <resource ref="Magento_Indexer::invalidate"/>
            <resource ref="MagoAssistant_Mago::reindex_all"/>
        </resources>
    </route>

    <route url="/V1/mago/indexers/reindex" method="POST">
        <service class="MagoAssistant\Mago\Api\WebApi\IndexerManagementInterface" method="reindex"/>
        <resources>
            <resource ref="Magento_Indexer::invalidate"/>
        </resources>
    </route>

    <route url="/V1/mago/chat" method="POST">
        <service class="MagoAssistant\Mago\Api\WebApi\ChatManagementInterface" method="sendMessage"/>
        <resources>
            <resource ref="MagoAssistant_Mago::assistant_read"/>
        </resources>
    </route>

    <route url="/V1/mago/conversations" method="GET">
        <service class="MagoAssistant\Mago\Api\WebApi\ChatManagementInterface" method="getConversations"/>
        <resources>
            <resource ref="MagoAssistant_Mago::assistant_read"/>
        </resources>
    </route>

    <route url="/V1/mago/conversations/:conversationId" method="GET">
        <service class="MagoAssistant\Mago\Api\WebApi\ChatManagementInterface" method="getConversation"/>
        <resources>
            <resource ref="MagoAssistant_Mago::assistant_read"/>
        </resources>
    </route>

    <route url="/V1/mago/conversations/:conversationId" method="DELETE">
        <service class="MagoAssistant\Mago\Api\WebApi\ChatManagementInterface" method="deleteConversation"/>
        <resources>
            <resource ref="MagoAssistant_Mago::assistant_write"/>
        </resources>
    </route>

    <route url="/V1/mago/confirm/:messageId" method="POST">
        <service class="MagoAssistant\Mago\Api\WebApi\ChatManagementInterface" method="confirmAction"/>
        <resources>
            <resource ref="MagoAssistant_Mago::assistant_write"/>
        </resources>
    </route>

    <route url="/V1/mago/reject/:messageId" method="POST">
        <service class="MagoAssistant\Mago\Api\WebApi\ChatManagementInterface" method="rejectAction"/>
        <resources>
            <resource ref="MagoAssistant_Mago::assistant_write"/>
        </resources>
    </route>

</routes>
