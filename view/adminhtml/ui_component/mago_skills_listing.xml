<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">

    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">mago_skills_listing.mago_skills_listing_data_source</item>
        </item>
    </argument>

    <settings>
        <spinner>mago_skills_columns</spinner>
        <deps>
            <dep>mago_skills_listing.mago_skills_listing_data_source</dep>
        </deps>
    </settings>

    <dataSource name="mago_skills_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="dataScope" xsi:type="string">data</param>
                <param name="cacheRequests" xsi:type="boolean">false</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>MagoAssistant_Mago::skills_read</aclResource>
        <dataProvider class="MagoAssistant\Mago\Ui\DataProvider\SkillsDataProvider" name="mago_skills_listing_data_source">
            <settings>
                <requestFieldName>name</requestFieldName>
                <primaryFieldName>name</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <columns name="mago_skills_columns">
        <column name="name" sortOrder="10">
            <settings>
                <label translate="true">Name</label>
                <filter>text</filter>
                <sorting>asc</sorting>
            </settings>
        </column>
        <column name="description" sortOrder="20">
            <settings>
                <label translate="true">Description</label>
                <filter>text</filter>
            </settings>
        </column>
        <column name="category" sortOrder="30" component="MagoAssistant_Mago/js/grid/columns/badge">
            <settings>
                <label translate="true">Category</label>
                <filter>select</filter>
            </settings>
        </column>
        <column name="type" sortOrder="40" component="MagoAssistant_Mago/js/grid/columns/badge">
            <settings>
                <label translate="true">Type</label>
                <filter>select</filter>
                <options class="MagoAssistant\Mago\Ui\Source\SkillType"/>
                <dataType>select</dataType>
            </settings>
        </column>
        <column name="assigned_users" sortOrder="50">
            <settings>
                <label translate="true">Users</label>
                <filter>text</filter>
                <sortable>false</sortable>
            </settings>
        </column>
        <actionsColumn name="actions" class="MagoAssistant\Mago\Ui\Component\Listing\Column\SkillActions" sortOrder="60">
            <settings>
                <label translate="true">Actions</label>
                <indexField>name</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
