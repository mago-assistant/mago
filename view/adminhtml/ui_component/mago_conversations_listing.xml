<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">

    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">mago_conversations_listing.mago_conversations_listing_data_source</item>
        </item>
    </argument>

    <settings>
        <spinner>mago_conversations_columns</spinner>
        <deps>
            <dep>mago_conversations_listing.mago_conversations_listing_data_source</dep>
        </deps>
    </settings>

    <dataSource name="mago_conversations_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>MagoAssistant_Mago::conversations</aclResource>
        <dataProvider class="MagoAssistant\Mago\Ui\DataProvider\ConversationsDataProvider"
                      name="mago_conversations_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <listingToolbar name="listing_top">
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="delete">
                <settings>
                    <url path="mago/conversations/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                    <confirm>
                        <message translate="true">Are you sure you want to delete the selected conversations? This will also delete all messages and usage data.</message>
                        <title translate="true">Delete Conversations</title>
                    </confirm>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>

    <columns name="mago_conversations_columns">
        <selectionsColumn name="ids" sortOrder="0">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="entity_id" sortOrder="10">
            <settings>
                <label translate="true">ID</label>
                <filter>textRange</filter>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="admin_username" sortOrder="20">
            <settings>
                <label translate="true">Admin User</label>
                <filter>text</filter>
                <sortable>true</sortable>
            </settings>
        </column>
        <column name="title" sortOrder="30">
            <settings>
                <label translate="true">Title</label>
                <filter>text</filter>
            </settings>
        </column>
        <column name="message_count" sortOrder="40">
            <settings>
                <label translate="true">Messages</label>
                <filter>textRange</filter>
                <sortable>true</sortable>
            </settings>
        </column>
        <column name="model" sortOrder="45">
            <settings>
                <label translate="true">Model</label>
                <filter>text</filter>
                <sortable>true</sortable>
                <visible>false</visible>
            </settings>
        </column>
        <column name="total_tokens" sortOrder="46">
            <settings>
                <label translate="true">Tokens</label>
                <filter>textRange</filter>
                <sortable>true</sortable>
                <visible>false</visible>
            </settings>
        </column>
        <column name="estimated_cost" sortOrder="47" class="MagoAssistant\Mago\Ui\Component\Listing\Column\Price">
            <settings>
                <label translate="true">Est. Cost</label>
                <filter>textRange</filter>
                <sortable>true</sortable>
            </settings>
        </column>
        <column name="skills_used" sortOrder="48" class="MagoAssistant\Mago\Ui\Component\Listing\Column\Skills">
            <settings>
                <label translate="true">Skills Used</label>
                <filter>text</filter>
                <sortable>false</sortable>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="50">
            <settings>
                <label translate="true">Created At</label>
                <filter>dateRange</filter>
                <dataType>date</dataType>
            </settings>
        </column>
        <column name="updated_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="60">
            <settings>
                <label translate="true">Updated At</label>
                <filter>dateRange</filter>
                <dataType>date</dataType>
            </settings>
        </column>
        <actionsColumn name="actions" class="MagoAssistant\Mago\Ui\Component\Listing\Column\ConversationActions" sortOrder="70">
            <settings>
                <label translate="true">Actions</label>
                <indexField>entity_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
