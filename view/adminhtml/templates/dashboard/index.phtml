    <div class="mago-section">
        <h3><?= $escaper->escapeHtml($currentPeriod === 'today' ? __('Hourly Trend') : __('Daily Trend')) ?></h3>
        <?php if (!empty($dailyTrend)): ?>
            <?php
            $trendCount = count($dailyTrend);
            $maxRequests = max(array_column($dailyTrend, 'requests'));
            $maxRequests = $maxRequests > 0 ? $maxRequests : 1;
            $svgW = 800;
            $svgH = 140;
            $padL = 0;
            $padR = 0;
            $padT = 10;
            $padB = 0;
            $chartW = $svgW - $padL - $padR;
            $chartH = $svgH - $padT - $padB;

            $points = [];
            foreach ($dailyTrend as $i => $day) {
                $x = $trendCount > 1 ? $padL + ($i / ($trendCount - 1)) * $chartW : $padL + $chartW / 2;
                $y = $padT + $chartH - (((int)$day['requests'] / $maxRequests) * $chartH);
                $points[] = ['x' => round($x, 1), 'y' => round($y, 1), 'day' => $day];
            }

            // Build smooth cubic bezier spline
            $n = count($points);
            $linePath = 'M' . $points[0]['x'] . ',' . $points[0]['y'];
            if ($n > 2) {
                $tension = 0.3;
                for ($i = 0; $i < $n - 1; $i++) {
                    $p0 = $points[max(0, $i - 1)];
                    $p1 = $points[$i];
                    $p2 = $points[$i + 1];
                    $p3 = $points[min($n - 1, $i + 2)];
                    $cp1x = round($p1['x'] + ($p2['x'] - $p0['x']) * $tension, 1);
                    $cp1y = round($p1['y'] + ($p2['y'] - $p0['y']) * $tension, 1);
                    $cp2x = round($p2['x'] - ($p3['x'] - $p1['x']) * $tension, 1);
                    $cp2y = round($p2['y'] - ($p3['y'] - $p1['y']) * $tension, 1);
                    $linePath .= ' C' . $cp1x . ',' . $cp1y . ' ' . $cp2x . ',' . $cp2y . ' ' . $p2['x'] . ',' . $p2['y'];
                }
            } elseif ($n === 2) {
                $linePath .= ' L' . $points[1]['x'] . ',' . $points[1]['y'];
            }
            $areaPath = $linePath . ' L' . end($points)['x'] . ',' . ($padT + $chartH) . ' L' . $points[0]['x'] . ',' . ($padT + $chartH) . ' Z';
            ?>
            <div class="mago-chart-area">
                <svg viewBox="0 0 <?= /* @noEscape */ (int)$svgW ?> <?= /* @noEscape */ (int)$svgH ?>" preserveAspectRatio="none">
                    <?php for ($g = 0; $g <= 4; $g++): ?>
                        <line class="mago-chart-area-grid" x1="<?= /* @noEscape */ (int)$padL ?>" y1="<?= /* @noEscape */ (float)($padT + ($chartH / 4) * $g) ?>" x2="<?= /* @noEscape */ (int)($svgW - $padR) ?>" y2="<?= /* @noEscape */ (float)($padT + ($chartH / 4) * $g) ?>" />
                    <?php endfor; ?>
                    <path class="mago-chart-area-fill" d="<?= /* @noEscape */ $areaPath ?>" />
                    <path class="mago-chart-area-line" d="<?= /* @noEscape */ $linePath ?>" />
                    <?php foreach ($points as $i => $p): ?>
                        <circle class="mago-chart-area-dot" cx="<?= /* @noEscape */ (float)$p['x'] ?>" cy="<?= /* @noEscape */ (float)$p['y'] ?>" r="3" data-tt="mm-tt-<?= /* @noEscape */ (int)$i ?>"
                                onmouseenter="document.getElementById(this.dataset.tt).classList.add('is-visible');this.setAttribute('r','5')"
                                onmouseleave="document.getElementById(this.dataset.tt).classList.remove('is-visible');this.setAttribute('r','3')" />
                    <?php endforeach; ?>
                </svg>
                <?php foreach ($points as $i => $p): ?>
                    <div class="mago-chart-area-tooltip" style="left:<?= /* @noEscape */ ($p['x'] / $svgW) * 100 ?>%;top:<?= /* @noEscape */ ($p['y'] / $svgH) * 100 ?>%;" id="mm-tt-<?= /* @noEscape */ (int)$i ?>">
                        <?= $escaper->escapeHtml($p['day']['date']) ?>: <?= (int)$p['day']['requests'] ?> req, <?= $escaper->escapeHtml($block->formatTokens((int)$p['day']['tokens'])) ?> tokens
                    </div>
                <?php endforeach; ?>
            </div>
            <div class="mago-chart-labels">
                <?php foreach ($dailyTrend as $i => $day):
                    $isHourly = $currentPeriod === 'today';
                    $step = $isHourly ? 3 : 7;
                    $showLabel = ($trendCount <= 7) || ($i === 0 || $i === $trendCount - 1 || $i % $step === 0);
                    $labelText = $isHourly ? substr($day['date'] ?? '', 11) : substr($day['date'] ?? '', 5);
                ?>
                    <span><?= $showLabel ? $escaper->escapeHtml($labelText) : '' ?></span>
                <?php endforeach; ?>
            </div>
        <?php else: ?>
            <div class="mago-empty"><?= $escaper->escapeHtml(__('No usage data yet.')) ?></div>
        <?php endif; ?>
    </div>

    <div class="mago-grid-2">
