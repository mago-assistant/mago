<script>
require(['MagoAssistant_Mago/js/markdown'], function(markdown) {
    var renderer = markdown.create({tableLabel: '<?= $escaper->escapeJs(__('Table')) ?>'});

    // Re-render all assistant bodies the same way the chat panel does: sanitized, links and
    // images held to the panel's rules, because a stored answer is model output too.
    document.querySelectorAll('.mago-conv-body[data-md]').forEach(function(el) {
        el.innerHTML = renderer.renderText(el.getAttribute('data-md'));
    });

    // Raw / Rendered toggle
    var rawActive = false;
    var btn = document.getElementById('mago-raw-toggle');
    if (btn) {
        btn.addEventListener('click', function() {
            rawActive = !rawActive;
            btn.classList.toggle('is-active', rawActive);
            btn.textContent = rawActive ? 'Rendered' : 'Raw';
            document.querySelectorAll('.mago-conv-body[data-md]').forEach(function(el) {
                if (rawActive) {
                    el.dataset.rendered = el.innerHTML;
                    var raw = el.getAttribute('data-md')
                        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
                    el.innerHTML = '<pre class="mago-conv-raw-pre">' + raw + '</pre>';
                } else {
                    el.innerHTML = el.dataset.rendered || renderer.renderText(el.getAttribute('data-md'));
                }
            });
        });
    }
});
</script>

