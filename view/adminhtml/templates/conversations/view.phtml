<script>
require(['jquery', 'Magento_Ui/js/modal/modal'], function($, modal) {
    var opts = {
        type: 'popup',
        title: '<?= $escaper->escapeJs(__('API Payload')) ?>',
        modalClass: 'mago-payload-modal-wrapper',
        buttons: [{
            text: $.mage.__('Close'),
            class: 'action-secondary',
            click: function() { this.closeModal(); }
        }]
    };
    var $el = $('#mago-payload-modal');
    modal(opts, $el);

    var readable = function(text) {
        if (!text) {
            return '';
        }
        try {
            var value = JSON.parse(text);
            return typeof value === 'string' ? value : JSON.stringify(value, null, 4);
        } catch (e) {
            return text;
        }
    };

    window.magoOpenPayloadModal = function(id) {
        var req = readable($('#mago-payload-req-' + id).text());
        var res = readable($('#mago-payload-res-' + id).text());
        $('#mago-payload-modal-req').text(req || 'Not recorded');
        $('#mago-payload-modal-res').text(res || 'Not recorded');
        $el.modal('openModal');
    };
});
</script>
<style>
    .mago-payload-modal-wrapper .modal-inner-wrap { width: 90vw; max-width: 1400px; }
    .mago-payload-modal-wrapper .modal-content { padding: 20px; }
</style>
